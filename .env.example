# ============================================================================
# 环境变量样例（A 股投研系统）
# ----------------------------------------------------------------------------
# 用法：复制本文件为 server/.env 后按需修改变量值：
#
#     cp .env.example server/.env      # Git Bash / macOS / Linux
#     copy .env.example server\.env    # Windows cmd
#
# 重要：dotenv 按「进程工作目录」（process.cwd()）查找 .env
# （见 server/src/index.ts:5 的 import 'dotenv/config'）。因此必须让工作目录是 server/：
#
#     cd server && npm run dev            # tsx watch src/index.ts，读 server/.env（推荐）
#     cd server && node dist/index.js     # 生产构建产物，同样读 server/.env
#
# 若在仓库根目录直接 `node server/dist/index.js`，dotenv 会去找 仓库根/.env，
# server/.env 不会被加载——所有变量都会退回代码内默认值（LLM 降级为规则引擎）。
#
# 全部变量均可选，只有 DEEPSEEK_API_KEY 属于「不设即功能降级」的关键项：
# 未设置时 isLLMAvailable() 为 false，8 位专家的 LLM 研判自动降级到规则引擎
# （见 server/src/llm/config.ts:28-31），其余功能不受影响。
#
# 请勿把任何真实密钥提交进版本库；server/.env 已在 .gitignore 中忽略。
# ============================================================================


# ============================================================================
# 一、启动与安全
# ============================================================================

# 运行环境：development / production / test。默认 development。
# 设为 production 时启用 SPA 同源静态托管（需先 npm run build 产出 client/dist）、
# 收紧 CORS 并隐藏 500 响应的 err.message；test 下不监听端口（供 supertest 引用 app）。
# 一般无需写进 .env，由命令行的 NODE_ENV=production 或 npm script 决定。
NODE_ENV=development

# HTTP 服务端口。可选，默认 3001。必须为 1-65535 的整数，否则启动即报错退出（server/src/utils/env.ts:56-60）。
PORT=3001

# 监听地址。可选，默认 127.0.0.1（仅本机可访问）。
# 本系统按本地单机定位且无鉴权，确需局域网访问时才改为 0.0.0.0（server/src/index.ts:259-261）。
HOST=127.0.0.1

# CORS 允许来源，多个用英文逗号分隔。可选，默认不限制来源。
# 生产环境未设置时仅打 warn，不会启动失败（server/src/utils/env.ts:71-75）；
# 建议生产环境显式设置以收紧策略。
ALLOWED_ORIGINS=

# 是否启用 HSTS 响应头（仅 HTTPS 部署有意义）。可选，默认关闭；只有值为 true 才启用（server/src/utils/env.ts:95）。
ENABLE_HSTS=false

# 反向代理场景下的 trust proxy 设置。可选，默认不信任（直连部署无需设置）。
# 支持预设名（loopback/linklocal/uniquelocal）、跳数（正整数）、CIDR 列表（逗号分隔）或 true/false。
# 经 nginx/负载均衡转发时不配置会让 req.ip 恒为代理 IP，所有客户端共享同一份限流配额（server/src/index.ts:40-59）。
TRUST_PROXY=

# 日志最低输出级别：debug / info / warn / error。可选，默认 info；非法值回落 info（server/src/utils/logger.ts:24-25）。
# debug 可见链路追踪 span 与模型调用明细。
LOG_LEVEL=info


# ============================================================================
# 二、LLM（专家研判 / 对话 / 抽取的模型能力）
# ============================================================================

# DeepSeek API key。★ 不设置时 LLM 整体不可用：专家研判降级到规则引擎、对话走降级应答、
# 文档洞察抽取同样降级。设置后即激活真 LLM。兼容任意 OpenAI 兼容接口（配合 DEEPSEEK_BASE_URL）。
# 官方申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容 key。可选。当 DEEPSEEK_API_KEY 未设置时作为备选 key 使用
# （server/src/llm/config.ts:18）。
OPENAI_API_KEY=

# 主模型 API base URL。可选，默认 https://api.deepseek.com/v1（server/src/llm/config.ts:19-23）。
# 优先级：DEEPSEEK_BASE_URL > OPENAI_BASE_URL > 默认值。末尾斜杠会被自动去掉。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 主模型 OpenAI 兼容 base URL（DEEPSEEK_BASE_URL 未设时生效）。可选。
OPENAI_BASE_URL=

# 主模型名。可选，默认 deepseek-chat。优先级：DEEPSEEK_MODEL > OPENAI_MODEL > 'deepseek-chat'。
DEEPSEEK_MODEL=deepseek-chat

# 主模型名（DEEPSEEK_MODEL 未设时生效）。可选。
OPENAI_MODEL=

# 通用模型名入口：供 utils/env.ts 的 loadEnv() 校验与生产启动日志展示用，默认不设。
# 注意它不会覆盖上面 getLLMConfig() 的取值优先级（真正生效的是 DEEPSEEK_MODEL / OPENAI_MODEL）。
LLM_MODEL=

# 通用 base URL 入口：同上，仅用于 loadEnv() 的配置快照，不改变 getLLMConfig() 的取值
# （真正生效的是 DEEPSEEK_BASE_URL / OPENAI_BASE_URL）。
LLM_BASE_URL=

# 廉价模型名：设置后加入模型注册表参与「按任务选最便宜模型」的路由。可选，默认不设（不参与路由）。
# 取值方式为「模型 ID」，成本单价另用 LLM_COST_IN_<模型ID大写> / LLM_COST_OUT_<模型ID大写> 覆盖（server/src/llm/config.ts:52-75）。
LLM_MODEL_CHEAP=

# 推理模型名：设置后加入注册表并承担 reasoning / analysis / debate 任务。可选，默认不设。
LLM_MODEL_REASONING=

# 模型成本单价覆盖（USD / 每 1k token），<模型ID大写> 需与模型名对应，例如主模型为
# deepseek-chat 时写 LLM_COST_IN_DEEPSEEK-CHAT / LLM_COST_OUT_DEEPSEEK-CHAT。
# 可选，未设置时该模型按 0 成本记账（仅影响成本治理与路由排序，不影响调用）。
# LLM_COST_IN_<MODEL_ID>=
# LLM_COST_OUT_<MODEL_ID>=

# 嵌入模型名。可选，默认与主模型相同。★ 注意：只有显式设置嵌入模型或独立嵌入端点时
# 才视为「嵌入选配可用」（server/src/llm/config.ts:125-131）；否则 RAG 取证干净回退 BM25，
# 不会对无 /embeddings 端点的服务发注定失败的请求。
LLM_EMBED_MODEL=

# 嵌入模型名（OpenAI 命名风格，LLM_EMBED_MODEL 未设时生效）。可选。
OPENAI_EMBED_MODEL=

# 独立嵌入端点 base URL。可选，默认复用主模型 baseUrl。优先级：LLM_EMBED_BASE_URL > OPENAI_EMBED_BASE_URL > 主模型 baseUrl。
LLM_EMBED_BASE_URL=

# 独立嵌入端点 base URL（LLM_EMBED_BASE_URL 未设时生效）。可选。
OPENAI_EMBED_BASE_URL=

# 嵌入模型名（utils/env.ts 的旧入口）。可选，仅用于 loadEnv() 的配置快照，不改变 getEmbedModel() 的取值。
EMBEDDING_MODEL=

# 多模型集成投票的模型数量。可选，默认不设 = 1（单模型，等于关闭集成）。
# 设为 >1 时并行多模型加权投票（llm/ensemble.ts:106）；设为 1 或留空即关闭。
LLM_ENSEMBLE_SIZE=

# 集成投票的命中率校准数据落盘路径。可选，默认 server/src/data/modelCalibration.json
# （llm/ensemble.ts:35-46）。一般只在测试隔离时需要改写。
MODEL_CALIBRATION_FILE=

# ===== LLM 并发闸门与入口限幅（utils/limitGate.ts）=====

# 全局 LLM 并发上限。可选，默认 8（= 单次深度分析的专家并行度，不拖慢常见路径）。
# 超过则排队，排队超时返回 429 + Retry-After。硬上界 32（防误配成"没有保护"）。
LLM_MAX_CONCURRENCY=8

# 排队等待配额的最长时间（毫秒）。可选，默认 30000。硬上界 600000。
# 排队只计"等配额"时间，不会偷走单次请求自身的超时预算。
LLM_QUEUE_TIMEOUT_MS=30000

# 单次补全 maxTokens 的上界。可选，默认 4096（硬上界 32768）。超过则夹紧并打 warn。
LLM_MAX_TOKENS_CAP=4096

# RAG 语料索引缓存 TTL（毫秒）。可选，默认 60000；设为 0 表示每次检索都重扫缓存目录。
# 文件新增/删除/被覆盖由「逐文件 mtime+size 签名」即时发现，TTL 只是省掉重复 stat 的兜底。
RAG_CORPUS_TTL_MS=60000


# ============================================================================
# 三、外部数据源（全部可选，未配置时增强通道优雅跳过，免费东财通道不受影响）
# ============================================================================

# Tushare Pro token。可选，默认不配置。未配置时退市股名单通道不可用
# （isTushareConfigured() 为 false，所有调用直接抛错并由调用方降级，server/src/quant/tushareAdapter.ts:32-52）。
# 免费积分频控很严：stock_basic 1 次/小时；index_weight 无权限。数据仅限本机研究，协议限制再分发。
TUSHARE_TOKEN=

# Python 解释器路径（供 Baostock sidecar 子进程使用）。可选，默认 python。
# 未安装 baostock 或解释器路径不对时，指数历史成分通道不可用并给出可执行指引（server/src/quant/baostockBridge.ts:42-45、88）。
# 需要：pip install baostock（见 README「可选增强（Python 侧车）」）。
PYTHON_BIN=python

# 东方财富搜索接口 token。可选，带内置默认值，一般无需修改（server/src/utils/env.ts:88-89）。
EASTMONEY_SEARCH_TOKEN=

# 外部 MCP 服务器 URL（SSE 传输）。可选，默认不设 = 跳过 MCP 增强步骤。
# 设置后分析管线会拉取外部工具清单并作为上下文附加到报告，连接失败降级为无字段（server/src/services/analysisPipeline.ts:793-819）。
MCP_SERVER_URL=

# 本地 API 基地址（供 MCP stdio 服务端转发请求，`npm run mcp:serve` 使用）。
# 可选，默认 http://127.0.0.1:3001（server/src/mcp/server.ts:22）。
MCP_API_BASE=http://127.0.0.1:3001

# 宽基基准 secid 覆盖（用于 Beta / 特异波动 / 残差动量计算），留空回落内置默认。
# 可选，默认：A 股 1.000300（沪深300）、美股 100.SPX（标普500）、港股 100.HSI（恒生）。
# 例：美股改纳指100 写 QUANT_BENCHMARK_SECID_US=100.NDX；A 股改中证500 写 1.000905（server/src/quant/dataProvider.ts:255-293）。
QUANT_BENCHMARK_SECID_A=
QUANT_BENCHMARK_SECID_US=
QUANT_BENCHMARK_SECID_HK=


# ============================================================================
# 四、限流（均为「每窗口请求数上限」，窗口默认 60 秒）
# ============================================================================

# 限流窗口（毫秒）。可选，默认 60000（server/src/middleware.ts:12）。
RATE_LIMIT_WINDOW_MS=60000

# 分析与对比类请求上限。可选，默认 10（server/src/middleware.ts:16）。
RATE_LIMIT_MAX_ANALYZE=10

# 股票搜索请求上限。可选，默认 30（server/src/middleware.ts:24）。
RATE_LIMIT_MAX_SEARCH=30

# 只读元数据（板块列表等）请求上限。可选，默认 30（server/src/middleware.ts:55）。
RATE_LIMIT_MAX_META=30

# 自选股批量回测 / 异动监控请求上限。可选，默认 3（server/src/middleware.ts:64）。
# 注：vitest 测试环境会由 vitest.config.mts 放大到 100，避免集成测试触发 429。
RATE_LIMIT_MAX_WATCHLIST=3

# 对话请求上限。可选，默认 10（server/src/middleware.ts:73）。
RATE_LIMIT_MAX_CHAT=10

# 只读健康/指标/契约端点上限。可选，默认 120（server/src/middleware.ts）。
# 取较宽的值是有意的：探针被限流会在监控侧表现成"服务返回 429"，
# 把探针频率问题伪装成故障告警；1 秒 1 次的激进探针也必须放行。
RATE_LIMIT_MAX_HEALTH=120

# 写操作（如 POST /api/cost/reset）上限。可选，默认 10（server/src/middleware.ts）。
# 写操作会抹掉用量/成本观测数据，不蹭读接口那档宽松配额。
RATE_LIMIT_MAX_WRITE=10

# 说明：股票对比固定 3 次/分钟、量化分析固定 5 次/分钟，为代码常量，不可用环境变量调整
# （server/src/middleware.ts:31-46）。


# ============================================================================
# 五、缓存与并发调优（不设都有默认值，只在调优/排障时改）
# ============================================================================

# 行情/财务数据缓存 TTL（小时）。可选，默认 24；必须 > 0，否则启动即报错（server/src/utils/env.ts:78-82）。
CACHE_TTL_HOURS=24

# 单进程内存 LRU 缓存条目上限。可选，默认 500（server/src/services/dataService.ts:35）。
MEM_CACHE_MAX=500

# 磁盘文件缓存条目上限，超出按时间戳淘汰最旧。可选，默认 2000（server/src/services/dataService.ts:61）。
FILE_CACHE_MAX=2000

# 量化侧（K 线 / 财报 / 事件 / 两融 / 一致预期 等）缓存目录的文件数上限。可选，默认 2000（server/src/quant/quantCache.ts:123-138）。
QUANT_CACHE_MAX_FILES=2000

# K 线缓存条目有效期（天），只影响 prune 是否保留文件；历史 K 线靠尾部增量补拉更新，而非过期重拉。可选，默认 30（server/src/quant/dataProvider.ts:73-77）。
QUANT_KLINE_CACHE_TTL_DAYS=30

# K 线「完全覆盖且新鲜」判定窗口（小时），窗口内重复请求零网络调用。可选，默认 12（server/src/quant/dataProvider.ts:83-87）。
QUANT_KLINE_FRESH_TTL_HOURS=12

# 财务快照缓存 TTL（小时）。可选，默认 24；显式 0 或负值 = 关闭该缓存（server/src/quant/fundamentalCache.ts:23-30、42）。
QUANT_FINANCIAL_CACHE_TTL_HOURS=24

# 季度财报序列缓存 TTL（小时）。可选，默认 168（7 天）；显式 0 或负值 = 关闭该缓存（server/src/quant/fundamentalCache.ts:51-61）。
QUANT_QUARTERLY_CACHE_TTL_HOURS=168

# 事件（分红/回购/解禁/龙虎榜等）缓存 TTL（小时）。可选，默认 24；显式 0 或负值 = 关闭该缓存（server/src/quant/eventProvider.ts:48-56）。
QUANT_EVENT_CACHE_TTL_HOURS=24

# 两融数据缓存 TTL（小时）。可选，默认 24；显式 0 或负值 = 关闭该缓存（server/src/quant/marginProvider.ts:49-56）。
QUANT_MARGIN_CACHE_TTL_HOURS=24

# 机构一致预期快照缓存 TTL（小时）。可选，默认 12；显式 0 或负值 = 关闭该缓存（server/src/quant/consensusProvider.ts:70-77）。
QUANT_CONSENSUS_CACHE_TTL_HOURS=12

# 公告缓存 TTL（小时）。可选，默认 24（正文为不可变数据，固定缓存 30 天，不受此变量影响）（server/src/quant/announcementProvider.ts:37-46）。
QUANT_ANNOUNCEMENT_CACHE_TTL_HOURS=24

# Tushare 通道缓存 TTL（小时）。可选，默认 24（频控纪律：请求路径一律走带缓存的包装函数，server/src/quant/tushareAdapter.ts:150）。
QUANT_TUSHARE_CACHE_TTL_HOURS=24

# Baostock 指数成分「最新快照」缓存 TTL（小时）。可选，默认 24；指定日期的历史快照固定缓存 30 天（server/src/quant/baostockBridge.ts:52-59、148）。
QUANT_BAOSTOCK_CACHE_TTL_HOURS=24

# 截面评估的股票池宽度上限（只放开上限，默认 topN 仍为 10）。可选，默认 300；硬上限 2000（server/src/routes/quant.ts:620-627）。
QUANT_CROSS_SECTION_MAX_CODES=300

# 截面评估的取数并发度。可选，默认 8；硬上限 16（server/src/routes/quant.ts:621-633）。
QUANT_CROSS_SECTION_CONCURRENCY=8

# 自选股批量新闻回测的并发度。可选，默认 4；会被夹紧到 [1,8]
# （一只股票要拉 2 年 K 线 + 新闻，配成 100 会瞬时打满上游）（server/src/services/watchlistBacktest.ts:47,63）。
WATCHLIST_CONCURRENCY=4

# 自选股清单容量上限。可选，默认 200（server/src/services/watchlistService.ts:46,52）。
# 满员时新增返回可操作的 400（提示先删除）；重复添加已有代码仍幂等成功。
WATCHLIST_MAX=200

# 单次批量回测 / 异动监控处理的股票数上限。可选，默认 20（server/src/services/watchlistBacktest.ts:50,57）。
# 超出部分会被跳过，并在响应与预警快照里如实披露 requested/skipped（不静默截断）。
# 之所以不整体 400：monitor 是定时器与自治循环驱动的唯一预警通道，拒绝等于关掉预警。
WATCHLIST_MAX_CODES=20

# 健康检查外呼探测的 memo 窗口（毫秒）。可选，默认 60000；设为 0 关闭 memo
# （server/src/routes/health.ts:43-113）。窗口内并发探针会合流成一次外呼。
HEALTH_PROBE_MEMO_MS=60000

# 全市场初筛扫描的股票数上限。可选，默认不设 = 不设上限（扫全市场，server/src/quant/screener.ts:82-87）。
QUANT_SCREENER_MAX=

# 研究简报定时生成的间隔（小时，允许小数，如 0.5 = 30 分钟；最小夹紧到 1 分钟）。可选，默认 0 = 关闭定时（不改动既有部署行为）（server/src/quant/researchDigest.ts:193-197）。
QUANT_DIGEST_INTERVAL_HOURS=0

# 模拟盘初始资金（元）。可选，默认 100000（server/src/routes/paper.ts:12）。
PAPER_INITIAL_CAPITAL=100000

# 审计日志单文件大小上限（字节），超过即轮转。可选，默认 5MB（server/src/services/auditLog.ts:307）。
AUDIT_LOG_MAX_BYTES=5242880

# 审计日志轮转保留份数（audit.log.1 ~ audit.log.N）。可选，默认 3（server/src/services/auditLog.ts:309）。
AUDIT_LOG_ROTATE_KEEP=3

# 分析断点续跑的 checkpoint 有效期（毫秒）。可选，默认 21600000（6 小时）（server/src/services/analysisCheckpoint.ts:39、69-73）。
ANALYSIS_CHECKPOINT_TTL_MS=21600000


# ============================================================================
# 六、数据文件路径（留空即用各模块内置默认路径；主要用于测试 / E2E 隔离）
# ============================================================================

# 数据缓存目录。可选，默认 server/src/data/cache（services）与 server/src/quant/cache（quant）（server/src/services/dataService.ts:17-18、server/src/quant/quantCache.ts:19-26）。
DATA_CACHE_DIR=

# 模拟盘账户落盘文件。可选，默认 server/src/data/paperTrading.json（server/src/quant/paperTrading.ts:34、101-104）。
PAPER_TRADING_FILE=

# 自选股清单落盘文件。可选，默认 server/src/data/watchlist.json（server/src/services/watchlistService.ts:19-24）。
WATCHLIST_FILE=

# 自选股异动监控「最近一次快照」落盘文件。可选，默认 server/src/data/watchlistAlerts.json
# （server/src/services/watchlistService.ts:121-128）。只保留最近一次结果，供页面刷新后回看。
WATCHLIST_ALERTS_FILE=

# 研究历史落盘文件。可选，默认 server/src/data/history.json（server/src/services/historyService.ts:53-54）。
HISTORY_FILE=

# 对话长期记忆落盘文件。可选，默认 server/src/data/chatHistory.json（server/src/services/chatMemory.ts:54-55）。
CHAT_HISTORY_FILE=

# 合规审计日志落盘文件。可选，默认 server/src/data/audit.log（server/src/services/auditLog.ts:304、356-357）。
AUDIT_LOG_FILE=

# 评级事后校准台账落盘文件。可选，默认 server/src/data/outcomes.json（server/src/services/outcomeTracker.ts:56-61）。
OUTCOME_FILE=

# 因子实验台账落盘文件。可选，默认 server/src/data/factorExperiments.json（server/src/quant/factorLedger.ts:58-66）。
FACTOR_LEDGER_FILE=

# 改进循环的周期调度间隔（小时；0 = 关闭，此时启动阶段不注册任何定时器）。
# 可选，默认 6 小时；上限 720（30 天）（server/src/services/improvementScheduler.ts:37-58）。
# 注意：证据下限（60 条可回放 / 20 条验证）与决策显著性水平（α=0.05）是**代码常量**，
# 有意不做成配置——它们决定判据会不会被自动改写，改它们应当走代码评审。
IMPROVEMENT_INTERVAL_HOURS=6

# 改进台账落盘文件。可选，默认 server/src/data/improvements.json（server/src/quant/improvementLedger.ts:79-85）。
IMPROVEMENT_LEDGER_FILE=

# 因子采信判据落盘文件（不存在 = 用出厂判据）。可选，默认 server/src/data/harnessPolicy.json
# （server/src/quant/harnessPolicy.ts:137-142）。删除该文件即回滚到出厂判据。
HARNESS_POLICY_FILE=

# 全市场初筛最新结果落盘文件。可选，默认 server/src/data/screenerLatest.json（server/src/quant/screener.ts:47、53-57）。
QUANT_SCREENER_FILE=

# 研究简报落盘文件。可选，默认 server/src/data/researchDigests.json（server/src/quant/researchDigest.ts:54-60）。
RESEARCH_DIGEST_FILE=

# 证券主数据（股票全表）缓存文件。可选，默认 server/src/data/stockMaster.json（server/src/services/stockMaster.ts:11、18-22）。
MASTER_CACHE=

# 分析断点续跑 checkpoint 目录。可选，默认 server/src/data/checkpoints（server/src/services/analysisCheckpoint.ts:62-67）。
ANALYSIS_CHECKPOINT_DIR=

# ===== 调优项（此前代码读取但未收录，2026-09-17 补齐）=====

# 成本台账保留条数上限。可选，默认 5000（server/src/llm/cost.ts:23、30）。
COST_LEDGER_MAX_ENTRIES=

# 价值分析结果内存缓存条数上限。可选，默认 500（server/src/services/dataFetcher.ts:349、358）。
VALUE_ANALYSIS_CACHE_MAX=

# 价值分析「失败结果」的负缓存 TTL（毫秒）。可选，默认 300000；显式设 0 = 不缓存失败结果
# （server/src/services/dataFetcher.ts:351、368）。
VALUE_ANALYSIS_NEGATIVE_TTL_MS=

# 模拟盘订单保留上限。可选，默认 2000（server/src/quant/paperTrading.ts:92、101）。
PAPER_MAX_ORDERS=

# 模拟盘净值点保留上限。可选，默认 2000（server/src/quant/paperTrading.ts:94、107）。
PAPER_MAX_EQUITY_POINTS=

# SSE 心跳间隔（毫秒）。可选，默认 15000；≤0 关闭心跳（server/src/utils/sse.ts:24、43）。
SSE_HEARTBEAT_MS=

# LLM 并发闸门的排队长度上限。可选，默认 200，硬上界 5000；
# 队列满时新调用立即以 429（LLM_QUEUE_TIMEOUT）拒绝，不再挂定时器等下去
# （server/src/utils/limitGate.ts:58-59、62）。
LLM_MAX_QUEUE=

# 错误响应里是否回传 detail（上游 URL / 本机路径等内部信息）。默认不传：
# errorDetail() 采用 fail-safe，只有 NODE_ENV=development|test 或显式 EXPOSE_ERROR_DETAIL=1
# 才回传（server/src/utils/errorDetail.ts:34-38）。本地排障可临时设为 1。
EXPOSE_ERROR_DETAIL=

# E2E 专用：设为 1 时强制重建 dist（e2e/global-setup.ts:64）。
E2E_FORCE_BUILD=