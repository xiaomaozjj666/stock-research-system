# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Cache（显式路径：任意层级的 cache/ 会让未来同名源码目录被静默忽略）
server/src/cache/
server/src/quant/cache/
# Python 产物（Baostock 等 Python 侧车可能产生）
__pycache__/
*.pyc
.venv/
# JSON artifacts (NOT package manifests or configs)
coverage/
*.coverage.json
# 运行时数据统一落在源码树外的 server/data/（2026-10-26 迁移，
# 见 server/src/dataRoot.ts）——整个目录忽略，server/src/data 只剩源码
server/data/
.coverage_tmp/

# Test artifacts
test-screenshots/
test-api-response.txt

# Environment
# 覆盖全部 .env*（.env.production / .env.development / .env.test / .env.bak …）：
# 只忽略 .env 与 .env.local 时，按 .env.example 宣传的 NODE_ENV=production 用法
# 很容易在 server/ 下留一份带密钥的 .env.production 而未被忽略。
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Playwright
.pw-browsers/
test-results/
playwright-report/
e2e/.tmp/

# 运行时数据（watchlist 等）
server/data/
server/src/data/watchlist.json
# 自选股异动监控「最近一次」快照（运行时生成，不入库）
server/src/data/watchlistAlerts.json

# UI screenshot artifacts (dev only)
_shots/

# 临时截图/脚本（README 截图生成中间产物）
_shots2/

server/src/data/paperTrading.json
server/src/data/screenerLatest.json

# 研究简报落盘（运行时数据，不入库）
server/src/data/researchDigests.json
