{
  "name": "stock-research-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "eslint . && oxlint server/src client/src e2e",
    "lint:fix": "eslint . --fix && oxlint server/src client/src e2e --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test:e2e": "playwright test",
    "mcp:serve": "npx tsx server/src/mcp/cli.ts",
    "format": "prettier --write \"server/src/**/*.{ts,tsx,js,json,md}\" \"client/src/**/*.{ts,tsx,js,json,md}\" \"e2e/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,tsx,js,json,mjs}\" \"*.{json,md,mjs,mts}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"server/src/**/*.{ts,tsx,js,json,md}\" \"client/src/**/*.{ts,tsx,js,json,md}\" \"e2e/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,tsx,js,json,mjs}\" \"*.{json,md,mjs,mts}\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "nanoid": "^3.3.18",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "vite": "8.3.0",
    "nanoid": "^3.3.18"
  }
}
