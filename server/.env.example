PORT=3001
CACHE_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANALYZE=10
RATE_LIMIT_MAX_SEARCH=30

# === LLM 配置（多专家仲裁） ===
# 填入 DeepSeek API key 后，6 位专家将升级为真 LLM 推理；留空则降级为规则引擎
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# 模型：deepseek-chat (V3，快速、性价比高) / deepseek-reasoner (R1，深度推理)
DEEPSEEK_MODEL=deepseek-chat
# API 地址（OpenAI 兼容接口均可，如智谱/通义/OpenAI 改此处）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === 东方财富搜索 Token（可选，不设则用内置默认值） ===
EASTMONEY_SEARCH_TOKEN=
# === 自选股批量回测并发上限（默认 4） ===
WATCHLIST_CONCURRENCY=4

# === 信任代理（可选）：反代（nginx/负载均衡）后必须设置，否则限流按代理 IP 共享 ===
# 取值：loopback / 跳数(如 1) / CIDR 列表(逗号分隔) / true；直连部署无需设置
# TRUST_PROXY=loopback

# === 审计日志落盘（可选） ===
# 单文件大小上限（字节，默认 5MB），超过自动轮转为 audit.log.1/.2/.3
# AUDIT_LOG_MAX_BYTES=5242880
# 轮转保留份数（默认 3）
# AUDIT_LOG_ROTATE_KEEP=3
